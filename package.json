{
  "name": "@hxtc/hexglass",
  "version": "0.5.1",
  "description": "Hex-Tech React component library — Base UI + Tailwind CSS, professional liquid glass.",
  "keywords": [
    "react",
    "components",
    "ui",
    "component-library",
    "design-system",
    "glassmorphism",
    "liquid-glass",
    "glass",
    "base-ui",
    "tailwindcss",
    "typescript",
    "dark-mode",
    "accessible"
  ],
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/noah-bar/HexGlass#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/noah-bar/HexGlass.git"
  },
  "bugs": {
    "url": "https://github.com/noah-bar/HexGlass/issues"
  },
  "sideEffects": [
    "**/*.css",
    "./dist/index.js"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "style": "./dist/hexglass.css",
  "exports": {
    ".": {
      "style": "./dist/hexglass.css",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/hexglass.css"
  },
  "scripts": {
    "dev": "storybook dev -p 6006",
    "build": "vite build && tsc -p tsconfig.build.json",
    "build-storybook": "storybook build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/addon-themes": "^10.6.1",
    "@storybook/react-vite": "^10.6.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-storybook": "^10.6.1",
    "globals": "^17.13.0",
    "lucide-react": "^1.52.0",
    "prettier": "^3.9.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "storybook": "^10.6.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.3"
  }
}
